# EDAI4 Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Google Gemini API (Required for Cognitive Layer)
# ============================================
GOOGLE_API_KEY=your_gemini_api_key_here

# ============================================
# Neo4j Database (Optional - for graph storage)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ============================================
# Application Settings
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Output directory for generated deliverables
OUTPUT_DIR=./data/output

# Input directory for P&ID files
INPUT_DIR=./data/input

# ============================================
# Model Paths
# ============================================
YOLO_WEIGHTS_PATH=./models/yolov8/best.pt

# ============================================
# OCR Settings
# ============================================
# Path to Tesseract executable (Windows)
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
